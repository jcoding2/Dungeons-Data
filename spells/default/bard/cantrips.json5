  {
    name: "Dancing Lights",
    id: "dancing-lights-0",
    level: 0,
    school: "illusion",
    concentration: true,
    casting_time: "1 action",
    range: [120, "ft"],
    components: ["V","S","M"],
    material_desc: "a bit of phosphorus",
