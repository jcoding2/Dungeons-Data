  {
    name: "Mage Hand",
    id: "mage-hand-0",
    level: 0,
    school: "conjuration",
    concentration: false,
    casting_time: "1 action",
    range: [30, "ft"],
    components: ["V","S"],
    material_desc: null,
    duration: [1, "minute"],
    type_1_duration: null,
    type_2_duration: null,
    type_3_duration: null,
    type_4_duration: null,
    type_5_duration: null,
    type_6_duration: null,
    desc: "A spectral, floating hand appears at a point you \
           choose within range. The hand lasts for the dura- \
           tion. The hand vanishes if it is ever more than 30 \
           feet away from you or if you cast this spell again. \
             When you cast the spell, you can use the hand \
           to manipulate an object, open an unlocked door or \
           container, stow or retrieve an item from an open \
           container, or pour the contents out of a vial. \
             As a Magic action on your later turns, you can \
           control the hand thus again. As part of that action, \
           you can move the hand up to 30 feet. \
             The hand can't attack, activate magic items, or \
           carry more than 10 pounds.",
    type_1: null,
    type_2: null,
    type_3: null,
    type_4: null,
    type_5: null,
    type_6: null,
  },
