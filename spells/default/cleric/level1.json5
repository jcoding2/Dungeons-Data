  spells: {
    cleric_bane_1: {
      name: "Bane",
      id: "cleric_bane_1",
      level: 1,
      school: "enchantment",
      concentration: true,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S","M"],
      material_desc: "a drop of blood",
      duration: [1, "minute"],
      desc: "Up to three creatures of your choice that you can see within range must each make a CHA saving throw. Whenever a target fails this save makes an attack or saving throw roll before the spell ends, the target must subtract 1d4 from the attack roll or save.",
      higher_levels: "You can target one additional creature for each spell slot level above 1."
    },
    cleric_bless_1: {
      name: "Bless",
      id: "cleric_bless_1",
      level: 1,
      school: "enchantment",
      concentration: true,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S","M"],
      material_desc: "a Holy Symbol worth 5+ GP",
      duration: [1, "minute"],
      desc: "You bless up to three creatures within range. Whenever a target makes an attack roll or a saving throw before the spell ends, the target adds 1d4 to the attack roll or save.",
      higher_levels: "You can target one additional creature for each spell slot level above 1."
    },
// clerics really confuse me sometimes. they're like one third Bard, one third Druid,
// and one third their own weird little thing.
    cleric_command_1: {
      name: "Command",
      id: "cleric_command_1",
      level: 1,
      school: "enchantment",
      concentration: false,
      casting_time: "1 action",
      range: [60, "ft"],
      components: ["V"],
      duration: [0, "seconds"],
      desc: "You speak a one-word command to a creature you can see within range. The target must succeed on a WIS saving throw or follow the command on its next turn. Choose the command from these options:",
      effects: {
        approach: {
          name: "Approach",
          desc: "The target moves toward you by the shortest and most direct route, ending its turn if it moves within 5 ft. of you."
        },
        drop: {
          name: "Drop",
          desc: "The target drops whatever it's holding and then ends its turn."
        },
        flee: {
          name: "Flee",
          desc: "The target spends its turn moving away from you by the fastest available means."
        },
        grovel: {
          name: "Grovel",
          desc: "The target has the Prone condition and then ends its turn."
        },
        halt: {
          name: "Halt",
          desc: "On its turn, the target doesn't move and takes no action nor Bonus Action."
        }
      },
      higher_levels: "You can affect one additional creature for each spell slot level above 1."
    },
    cleric_create_or_destroy_water_1: {
      name: "Create or Destroy Water",
      id: "cleric_create_or_destroy_water_1",
      level: 1,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S","M"],
      material_desc: "a mix of water and sand",
      duration: [0, "seconds"], // I just noticed that technically any Instantaneous spells cannot be Concentration as there'd be nothing to concentrate on. Huh.
      effects: {
        create_water: {
          name: "Create Water",
          desc: "You create up to 10 gal. of clean, fresh water within range in \
an open container. Alternatively, the water falls as rain in a 30 ft. Cube within \
range, extinguishing exposed flames there."
        },
        destroy_water: {
          name: "Destroy Water",
          desc: "You destroy up to 10 gal. of water in an open container within \
range. Alternatively, you destroy fog in a 30 ft. Cube within range."
        },
      },
    },
    // honestly, it's kinda nice not having to constantly write new spells,
    // just having to copy and paste them.
    cleric_cure_wounds_1: {
      name: "Cure Wounds",
      id: "cleric_cure_wounds_1",
      level: 1,
      school: "abjuration",
      concentration: false,
      casting_time: "1 action",
      range: "touch",
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "A creature you touch regains a number of hit points equal to 2d8 plus your spellcasting ability modifier.",
      higher_levels: "The healing increases by 2d8 for each spell slot level above 1."
    },
    cleric_detect_evil_and_good_1: {
      name: "Detect Evil and Good",
      id: "cleric_detect_evil_and_good_1",
      level: 1,
      school: "divination",
      concentration: true,
      casting_time: "1 action",
      range: "self",
      components: ["V","S"],
      duration: [10, "minute"],
      desc: "For the duration, you sense the location of any Aberration, Celes- \
tial, Elemental, Fey, Fiend, or Undead within 30 ft. of you. You also sense whether \
the Hallow spell is active there and, if so, where. \
\
The spell is blocked by 1 ft. of stone, dirt, or wood, 1 in. of metal, or a thin sheet of lead."
    },
    // seems like Clerics are really good at detecting things
    cleric_detect_magic_1: {
      name: "Detect Magic",
      id: "cleric_detect_magic_1",
      level: 1,
      school: "divination",
      concentration: true,
      casting_time: "1 action, or 1 ritual",
      range: "self",
      components: ["V","S"],
      duration: [10, "minute"],
      desc: "For the duration, you sense the presence of magical effects within 30 ft. of yourself. If you sense such effects, you can take the Magic action to see a faint aura around any visible creature or object in the area that bears the magic, and if an effect was created by a spell, you learn the spell's school of magic. The spell is blocked by 1 ft. of stone, dirt, or wood; or a thin sheet of lead.",
    },
    cleric_detect_poison_and_disease_1: {
      name: "Detect Poison and Disease",
      id: "cleric_detect_poison_and_disease_1",
      level: 1,
      school: "divination",
      concentration: true,
      casting_time: "1 action, or 1 ritual",
      range: "self",
      components: ["V","S","M"],
      material_desc: "a yew (aka deathberry) leaf",
      duration: [10, "minute"],
      desc: "For the duration, you sense the location of poisons, poisonous or venomous creatures, and \
magical contagions within 30 ft. of yourself. You sense the kind of poison, creature, or contagion in each \
case. The spell is blocked by 1 ft. of stone, dirt, or wood; 1 in. of metal, or a thin sheet of lead."
    },
