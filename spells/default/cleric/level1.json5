      concentration: false,
      casting_time: "1 action, or 1 ritual",
      range: [10, "ft"],
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "You remove poison and rot form nonmagical food and rink in a 5 ft. \
radius Sphere centered on a point within range."
    },
