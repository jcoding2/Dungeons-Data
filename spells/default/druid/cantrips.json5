{
  name: "Druid Cantrips (SRD)",
  date_added: "7/7/2026",
  last_updated: "9/3/2026",
  source: "System Reference Document 5.2.1",
  author: "Dungeons & Data authors",
  spells: {
    druid_druidcraft_0: {
      name: "Druidcraft",
      id: "druid_druidcraft_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V", "S"],
      duration: [0, "seconds"],
      desc: "Whispering to the spirits of nature, you create one of the following effects within range.",
      effects: {
        weather_sensor: {
          name: "Weather Sensor",
          desc: "You create a Tiny, harmless sensory effect that predicts what the weather will be \
                 at your location for the next 24 hours. The effect might manifest as a golden orb \
                 for clear skies, a cloud for rain, falling snowflakes for snow, and so on. This   \
                 effect persists for 1 round.",
          duration: [1, "round"],
        },
        bloom: {
          name: "Bloom",
          desc: "You instantly make a flower blossom, a seed pod open, of a leaf bud bloom."
        },
        sensory_effect: {
          name: "Sensory Effect",
          desc: "You create a harmless sensory effect, such as falling leaves, spectral dancing \
                 fairies, a gentle breeze, the sound of an animal, or the faint odor of a skunk. \
                 The effect must fit in a 5 ft. Cube."
        },
        fire_play: {
          name: "Fire Play",
          desc: "You light or snuff out a candle, a torch of a campfire."
        }
      },
    },
    druid_elementalism_0: {
      name: "Elementalism",
      id: "druid_elementalism_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S"],
      desc: "You exert control over the elements, creating one of the following effects within range.",
      effects: {
        beckon_air: {
          name: "Beckon Air",
          desc: "You create a breeze strong enough to ripple cloth, stir dust, rustle leaves, and \
                 close open doors and shutters, all in a 5 ft. Cube. Door and shutters being held \
                 open by someone or something aren't affected."
        },
        beckon_earth: {
          name: "Beckon Earth",
          desc: "You create a thin shroud of dust or sand that covers surfaces in a 5 ft. square \
                 area, or you cause a single word to appear in your handwriting in a patch of dirt \
                 or sand."
        },
        beckon_fire: {
          name: "Beckon Fire",
          desc: "You create a thin cloud of harmless embers and colored, scented smoke in a 5 ft. \
                 Cube. You choose the color and scent, and the embers can light candles, torches or \
                 lamps in that area. The smoke's scent lingers for one minute.",
          duration: [1, "minute"]
        },
        beckon_water: {
          name: "Beckon Water",
          desc: "You create a spray of cool mist that lightly dampens creatures and objects in a \
                 5 ft. Cube. Alternatively, you create one cup of clean water either in an open \
                 container or on a surface, and the water evaporates in 1 minute.",
          duration: [1, "minute"],
        },
        sculpt_element: {
          name: "Sculpt Element",
          desc: "You cause dirt, sand, fire, smoke, mist or water that can fit in a 1 ft. Cube \
                 to assume a crude shape (such as that of a creature) for 1 hour.",
          duration: [1, "hour"],
        }
      }
    }
  }
}