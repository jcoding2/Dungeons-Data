{
  name: "Druid Level 1 Spells (SRD)",
  date_added: "September 6th, 2026",
  last_updated: "September 6th, 2026",
  source: "System Reference Document v5.2.1",
  author: "Dungeons and Data authors",
  spells: {
    druid_animal_friendship_1: {
      name: "Animal Friendship",
      id: "druid_animal_friendship_1",
      level: 1,
      school: "enchantment",
      concentration: false,
      casting_time: "1 action",
      range: [60, "ft"],
      components: ["V","S","M"],
      material_desc: "a morsel of food",
      duration: [24, "hour"],
      desc: "Target a Beast that you can see within range. The target must succeed on a Wisdom saving throw or have the Charmed condition for the duration. If you or one of your allies deals damage to the target, the spell ends.",
      higher_levels: "You can target one additional Beast for each spell slot level above 1."
    },
    druid_charm_person_1: {
      name: "Charm Person",
      id: "druid_charm_person_1",
      level: 1,
      school: "enchantment",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S"],
      duration: [1, "hour"],
      desc: "One Humanoid you can see within range makes a WIS saving throw. It does so with Advantage if you (or your allies) are fighting it. On a failed save, the target has the Charmed condition until the spell ends or until you or your allies damage it. The Charmed creature is Friendly to you. When the spell ends, the target knows it was Charmed by you.",
      higher_levels: "You can target one additional creature for each spell slot level above 1."
    },
    druid_cure_wounds_1: {
      name: "Cure Wounds",
      id: "druid_cure_wounds_1",
      level: 1,
      school: "abjuration",
      concentration: false,
      casting_time: "1 action",
      range: "touch",
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "A creature you touch regains a number of hit points equal to 2d8 plus your spellcasting ability modifier.",
      higher_levels: "The healing increases by 2d8 for each spell slot level above 1."
    },
    druid_detect_magic_1: {
      name: "Detect Magic",
      id: "druid_detect_magic_1",
      level: 1,
      school: "divination",
      concentration: true,
      casting_time: "1 action, or 1 ritual",
      range: "self",
      components: ["V","S"],
      duration: [10, "minute"],
      desc: "For the duration, you sense the presence of magical effects within 30 ft. of yourself. If you sense such effects, you can take the Magic action to see a faint aura around any visible creature or object in the area that bears the magic, and if an effect was created by a spell, you learn the spell's school of magic. The spell is blocked by 1 ft. of stone, dirt, or wood; or a thin sheet of lead.",
    },
    druid_faerie_fire_1: {
      name: "Faerie Fire",
      id: "druid_faerie_fire_1",
      level: 1,
      school: "evocation",
      concentration: true,
      casting_time: "1 action",
      range: [60, "ft"],
      components: ["V"],
      duration: [1, "minute"],
      desc: "Objects in a 20 ft. Cube within range are outlined in blue, green, or violet light (your choice). Each creature in the Cube is also outlined if it fails a DEX saving throw. For the duration, objects and affected creatures shed Dim Light in a 10 ft. radius and can't benefit from the Invisible condition. \
Attack rolls against an affected creature or object have Advantage if the attacker can see it."
    },
    druid_healing_word_1: {
      name: "Healing Word",
      id: "druid_healing_word_1",
      level: 1,
      school: "abjuration",
      concentration: false,
      casting_time: "1 bonus action",
      range: [60, "ft"],
      components: ["V"],
      duration: [0, "seconds"],
      desc: "A creature of your choice that you can see within range regains Hit Points equal to 2d4 plus your spellcasting ability modifier.",
      higher_levels: "The healing increases by 2d4 for each spell slot level above 1."
    },
    druid_longstrider_1: {
      name: "Longstrider",
      id: "druid_longstrider_1",
      level: 1,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: "touch",
      components: ["V","S","M"],
      material_desc: "a pinch of dirt",
      duration: [1, "hour"],
      desc: "You touch a creature. The target's Speel increases by 10 ft. until the spell ends.",
      higher_levels: "You can target one additional creature for each spell slot level above 1."
    },
    druid_speak_with_animals_1: {
      name: "Speak with Animals",
      id: "druid_speak_with_animals_1",
      level: 1,
      school: "divination",
      concentration: false,
      casting_time: "1 action, or 1 ritual",
      range: "self",
      components: ["V","S"],
      duration: [10, "minute"],
      desc: "For the duration, you can comprehend and verbally communicate with Beasts, and you can use any of the Influence action's skill options with them. \
Most Beasts have little to say about topics that don't pertain to survival or companionship, but at minimum, a Beast can give you information about nearby locations and monsters, including whatever it has percieved within the past day."
    },
    druid_thunderwave_1: {
      name: "Thunderwave",
      id: "druid_thunderwave_1",
      level: 1,
      school: "evocation",
      concentration: false,
      casting_time: "1 action",
      range: "self",
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "You unleash a wave of thunderous energy. Each creature in a 15 ft. Cube originating from you makes a CON saving throw. On a failed save, a creature takes 2d8 Thunder damage and is pushed 10 ft. away from you. On a successful save, a creature takes half as much damage only. \
In addition, unsecured objects that are entirely within the Cube are pushed 10 ft. away from you, and a thunderous boom is audible within 300 ft.",
      higher_levels: "The damage increases by 1d8 for each spell slot level above 1."
    },
  }
}