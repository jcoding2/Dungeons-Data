  spells: {
    sorcerer_acid_splash_0: {
      name: "Acid Splash",
      id: "sorcerer_acid_splash_0",
      level: 0,
      school: "evocation",
      concentration: false,
      casting_time: "1 action",
      range: [60, "ft"],
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "You create an acidic bubble at a point within range, where it \
             explodes in a 5 ft. radius Sphere. Each creature in that Sphere \
             must succeed on a DEX saving throw or take 1d6 of damage.",
      cantrip_upgrade: "The damage increases by 1d6 when you reach levels 5 \
                        (2d6), 11 (3d6) and 17 (4d6)."
    },
    sorcerer_chill_touch_0: {
      name: "Chill Touch",
      id: "sorcerer_chill_touch_0",
      level: 0,
      school: "necromancy",
      concentration: false,
      casting_time: "1 action",
      range: "touch",
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "Channeling the chill of the grave, make a melee spell attack \
             against a target within reach. On a hit, the target takes 1d10 \
             Necrotic damage, and it can't regain Hit Points until the end \
             of your turn.",
      cantrip_upgrade: "The damage increases by 1d10 when you reach levels \
                        5 (2d10), 11 (3d10), and 17 (4d10)."
    },
    sorcerer_dancing_lights_0: {
      name: "Dancing Lights",
      id: "sorcerer_dancing_lights_0",
      level: 0,
      school: "illusion",
      concentration: true,
      casting_time: "1 action",
      range: [120, "ft"],
      components: ["V","S","M"],
      material_desc: "a bit of phosphorus",
      duration: [1, "minute"],
      desc: "You create up to four torch-size lights within range, \
            making them appear as torches, lanterns or glow- \
            ing orbs that hover for the duration. Alternatively, \
            you combine the four lights into one flowing Me- \
            dium form that is vaguely humanlike. Whichever \
            form you choose, each light sheds Dim Light in a \
            10-foot radius. \
            As a Bonus Action, you can move the lights up \
            to 60 feet to a space within range. A light must be \
            within 20 feet of another light created by this spell, \
            and a light vanishes if it exceeds the spell's range.",
    },
    sorcerer_elementalism_0: {
      name: "Elementalism",
      id: "sorcerer_elementalism_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S"],
      desc: "You exert control over the elements, creating one of the following effects within range.",
      effects: {
        beckon_air: {
          name: "Beckon Air",
          desc: "You create a breeze strong enough to ripple cloth, stir dust, rustle leaves, and \
                 close open doors and shutters, all in a 5 ft. Cube. Door and shutters being held \
                 open by someone or something aren't affected."
        },
        beckon_earth: {
          name: "Beckon Earth",
          desc: "You create a thin shroud of dust or sand that covers surfaces in a 5 ft. square \
                 area, or you cause a single word to appear in your handwriting in a patch of dirt \
                 or sand."
        },
        beckon_fire: {
          name: "Beckon Fire",
          desc: "You create a thin cloud of harmless embers and colored, scented smoke in a 5 ft. \
                 Cube. You choose the color and scent, and the embers can light candles, torches or \
                 lamps in that area. The smoke's scent lingers for one minute.",
          duration: [1, "minute"]
        },
        beckon_water: {
          name: "Beckon Water",
          desc: "You create a spray of cool mist that lightly dampens creatures and objects in a \
                 5 ft. Cube. Alternatively, you create one cup of clean water either in an open \
                 container or on a surface, and the water evaporates in 1 minute.",
          duration: [1, "minute"],
        },
        sculpt_element: {
          name: "Sculpt Element",
          desc: "You cause dirt, sand, fire, smoke, mist or water that can fit in a 1 ft. Cube \
                 to assume a crude shape (such as that of a creature) for 1 hour.",
          duration: [1, "hour"],
        }
      }
    },
    sorcerer_fire_bolt_0:{
      name: "Fire Bolt",
      id: "sorcerer_fire_bolt_0",
      level: 0,
      school: "evocation",
      concentration: false,
      casting_time: "1 action",
      range: [120, "ft"],
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "You hurl a mote of fire at a creature or an object within range. \
             Make a ranged spell attack against the target. On a hit, the target \
             takes 1d10 Fire damage. A flammable object hit by this spell starts \
             burning if it isn't being worn or carried.",
      cantrip_upgrade: "The damage increases by 1d10 when you reach levels 5 (2d10), \
                        11 (3d10) and 17 (4d10)."
    },
    sorcerer_light_0: {
      name: "Light",
      id: "sorcerer_light_0",
      level: 0,
      school: "evocation",
      concentration: false,
      casting_time: "1 action",
      range: "touch",
      components: ["V","M"],
      material_desc: "a firefly or phosphorescent moss",
      duration: [1, "hour"],
      desc: "You touch one Large or smaller object that isn't \
            being worn or carried by someone else. Until the \
            spell ends, the object sheds Bright Light in a 20-foot \
            radius and Dim Light for another 20 feet. The \
            light can be colored as you like. \
            Covering the object with something opaque \
            blocks the light. The spell ends if you cast it again.",
    },
    sorcerer_mage_hand_0: {
      name: "Mage Hand",
      id: "sorcerer_mage_hand_0",
      level: 0,
      school: "conjuration",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S"],
      duration: [1, "minute"],
      desc: "A spectral, floating hand appears at a point you \
            choose within range. The hand lasts for the dura- \
            tion. The hand vanishes if it is ever more than 30 \
            feet away from you or if you cast this spell again. \
            When you cast the spell, you can use the hand \
            to manipulate an object, open an unlocked door or \
            container, stow or retrieve an item from an open \
            container, or pour the contents out of a vial. \
            As a Magic action on your later turns, you can \
            control the hand thus again. As part of that action, \
            you can move the hand up to 30 feet. \
            The hand can't attack, activate magic items, or \
            carry more than 10 pounds.",
    },
    sorcerer_mending_0: {
      name: "Mending",
      id: "sorcerer_mending_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: "1 minute",
      range: "touch",
      components: ["V","S","M"],
      material_desc: "two lodestones",
      duration: [0, "seconds"],
      desc: "This spell repairs a single break or tear in an object \
            you touch, such as a broken chain link, two halves \
            of a broken key, a torn cloak, or a leaking wineskin. \
            As long as the break or tear is no larger than 1 foot \
            in any dimension, you mend it, leaving no trace of \
            the former damage. \
            This spell can physically repair a magic item, but \
            it can't restore magic to such an object.",
    },
    sorcerer_message_0: {
      name: "Message",
      id: "sorcerer_message_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: "1 action",
      range: [120, "ft"],
      components: ["S","M"],
      material_desc: "a copper wire",
      duration: [1, "round"],
      desc: "You point toward a creature within range and \
            whisper a message. The target (and only the target) \
            hears the message and can reply in a whisper that \
            only you can hear. \
            You can cast this spell through solid objects if you \
            are familiar with the target and know it is beyond \
            the barrier. Magical silence; 1 foot of stone, metal or \
            wood; or a thin sheet of lead blocks the spell.",
    },
    sorcerer_minor_illusion_0: {
      name: "Minor Illusion",
      id: "sorcerer_minor_illusion_0",
      level: 0,
      school: "illusion",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["S","M"],
      material_desc: "a bit of fleece",
      duration: [1, "minute"],
      desc: "You create a sound or an image of an object within \
            range that lasts for the duration. See the descrip- \
            tions below for the effects of each. The illusion ends \
            if you cast this spell again.\
            If a creature takes a Study action to examine the \
            sound or image, the creature can determine that it \
            is an illusion with a successful INT (Investigation) \
            check against your spell save DC. If a creature disc- \
            erns the illusion for what it is, the illusion becomes \
            faint to the creature.",
      effects: {
        sound: {
          name: "Sound",
          desc: "If you create a sound, its volume can \
                range from a whisper to a scream. It can be your \
                voice, someone else's voice, a lion's roar, a beating of \
                drums, or any other sound you choose. The sound \
                continues unabated throughout the duration, or you \
                can make discrete sounds at different times before \
                the spell ends.",
        },
        image: {
          name: "Image",
          desc: "If you create an image of an object--such \
                as a chair, muddy footprints, or a small chest--it \
                must be no larger than a 5 ft Cube. The image \
                can't create sound, light, smell, or any other sensory \
                effect. Physical interation with the image reveals it \
                to be an illusion, since things can pass through it.",
        },
      },
    },
    sorcerer_poison_spray_0: {
      name: "Poison Spray",
      id: "sorcerer_poison_spray_0",
      level: 0,
      school: "necromancy",
      concentration: false,
      casting_time: "1 action",
      range: [30, "ft"],
      components: ["V","S"],
      duration: [0, "seconds"],
      desc: "You spray toxic mist at a creature within range. Make \
             a ranged spell attack against the target. On a hit, the \
             target takes 1d12 Poison damage.",
      cantrip_upgrade: "The damage increases by 1d12 when you reach \
                        levels 5 (2d12), 11 (3d12), and 17 (4d12)."
    },
    sorcerer_prestidigitation_0: {
      name: "Prestidigitation",
      id: "sorcerer_prestidigitation_0",
      level: 0,
      school: "transmutation",
      concentration: false,
      casting_time: [1, "action"],
      range: [10, "ft"],
      components: ["V","S"],
      desc: "You create a magical effect within range. Choose \
            the effect from the options below. If you cast this \
            spell multiple times, you can have up to three of its \
            non-instantaneous effects active at a time.",
      effects: {
        sensory_effect: {
          name: "Sensory Effect",
          desc: "You create an instantaneous, harmless sensory effect, such as a shower of sparks, \
                a puff of wind, faint musical notes, or an odd odor.",
          duration: [0, "seconds"],
        },
        fire_play: {
          name: "Fire Play",
          desc: "You instantaneously light or snuff out a candle, a torch, or a small campfire.",
          duration: [0, "seconds"],
        },
        clean_or_soil: {
          name: "Clean or Soil",
          desc: "You instantaneously clean or soil an object no longer than 1 cubic foot.",
          duration: [0, "seconds"],
        },
        minor_sensation: {
          name: "Minor Sensation",
          desc: "You chill, warm, or flavor up to 1 cubic foot of nonliving material for 1 hour.",
          duration: [1, "hour"],
        },
        magic_mark: {
          name: "Magic Mark",
          desc: "You create a color, a small mark, or a symbol appear on an object or a surface for 1 hour.",
          duration: [1, "hour"],
        },
        minor_creation: {
          name: "Minor Creation",
          desc: "You create a nonmagical trinket or an illusory image that can fit in your hand. It \
                lasts until the end of your next turn. A trinket can deal no damage and has no monetary worth.",
          duration: [0, "seconds"],
        },
      },
    },
    sorcerer_ray_of_frost_0: {
      name: "Ray of Frost",
      id: "sorcerer_ray_of_frost_0",
      level: 0,
      school: "evocation",
      concentration: false,
      casting_time: "1 action",
      range: [60, "ft"],
      components: ["V","S"],
      desc: "A frigid beam of blue-white light streaks toward a creature within range. Make a ranged \
             spell attack against the target. On a hit, it takes 1d8 Cold damage, and its Speed is \
             reduced by 10 ft. until the start of your next turn.",
      cantrip_upgrade: "The damage increases by 1d8 when you reach levels 5 (2d8), 11 (3d8) and 17 (4d8)."
    },
